{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      },
      "channel": "production"
    },
    "production-local": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      },
      "channel": "production"
    },
    "staging-local": {
      "android": {
        "buildType": "apk"
      },
      "channel": "staging",
      "env": {
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "APP_VARIANT": "staging",
        "API_BASE": "https://loot-api.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./play-store-key.json",
        "track": "alpha"
      }
    }
  }
}
